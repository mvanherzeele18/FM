rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function allowedTestUser() {
      return signedIn() && request.auth.token.email == 'vanherzeelematteo@gmail.com';
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    // Client-only game engine: signed-in users can update shared game state.
    // This is suitable for a private prototype, NOT a cheat-resistant public league.
    match /world/{docId} {
      allow read, write: if signedIn();
    }
    match /matches/{matchId} {
      allow read, write: if signedIn();
    }
    // Testomgeving: enkel het expliciet toegelaten Firebase-account.
    match /testUsers/{uid} {
      allow read, create: if allowedTestUser() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /testWorld/{docId} {
      allow read, write: if allowedTestUser();
    }
    match /testMatches/{matchId} {
      allow read, write: if allowedTestUser();
    }
  }
}