rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    // Client-only game engine: signed-in users can update shared game state.
    // This is suitable for a private prototype, NOT a cheat-resistant public league.
    match /world/{docId} {
      allow read, write: if signedIn();
    }
    match /matches/{matchId} {
      allow read, write: if signedIn();
    }
    // Separate collections for the test branch; production data stays untouched.
    match /testUsers/{uid} {
      allow read, create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /testWorld/{docId} {
      allow read, write: if signedIn();
    }
    match /testMatches/{matchId} {
      allow read, write: if signedIn();
    }
  }
}