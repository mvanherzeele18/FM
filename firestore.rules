rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gebruikersprofielen: elke ingelogde manager beheert zijn eigen profiel.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /saves/{saveId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Gedeelde multiplayer-wereld (wereldwijd of per wereld-ID).
    // Elke ingelogde manager mag lezen; updates gebeuren via gecontroleerde app-transacties.
    match /worlds/{worldId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      // Individuele clubdocumenten in de gedeelde wereld
      match /clubs/{clubId} {
        allow read: if request.auth != null;
        // Aanmaken bij wereld-initialisatie door een ingelogde gebruiker
        allow create: if request.auth != null;
        // Eigenaar van de club mag zijn eigen club aanpassen (opstelling, tactiek, training, aankopen),
        // of een vrije botclub mag geclaimd worden door een nieuwe speler,
        // of speeldag-resultaten worden bijgewerkt.
        allow update: if request.auth != null && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.isBot == true && request.resource.data.ownerUid == request.auth.uid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'points', 'played', 'wins', 'draws', 'losses', 'gf', 'ga',
            'cash', 'players', 'league', 'form', 'lastMatchSummary'
          ])
        );
        allow delete: if false;
      }

      // Gedeelde transfermarkt & transferlog
      match /market/{itemId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Live/recente wedstrijden per speeldag
      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
